# Plans, scratch, reviews. Never committed.
_plans/
_tmp/
_reviews/
_reports/

# The corpus measurement and the rollout record. Kept locally and not
# published: they name other projects and their edit volumes, which is
# nobody else's business. _plans/ is gitignored too, so these are the only
# copies. Do not let them be the only copies of anything that matters.
docs/
# The benchmark's staging directory (scripts/bench.sh).
_bench/

# Build output.
/hunk

# Skill eval runs: 36 fixture repos and their transcripts, regenerated per
# iteration. The method is tracked (skills/hunk/evals/), the runs are not,
# exactly as _reports/ holds the corpus measurement's output.
skills/*-workspace/

# The grader's tests import grade.py, and importing compiles it.
__pycache__/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# AI files. Local law and local scratch, none of it committed.
CLAUDE.md
GEMINI.md
